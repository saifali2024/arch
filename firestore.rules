rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all rule: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Records Collection
    match /records/{recordId} {
      allow read: if true;
      allow create, update: if isValidRecord();
      allow delete: if true;
    }
    
    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser();
      allow delete: if true;
    }
    
    // Validation Helper for Records
    function isValidRecord() {
      let data = request.resource.data;
      return data.id is string 
        && data.id.size() <= 128
        && data.ministry is string
        && data.ministry.size() <= 200
        && data.fundingType is string
        && data.departmentName is string
        && data.departmentName.size() <= 250
        && data.year is int
        && data.month is int
        && data.totalSalaries is number
        && data.employeeCount is int
        && data.deduction10 is number
        && data.deduction15 is number
        && data.deduction25 is number
        && data.submittedAt is string;
    }
    
    // Validation Helper for Users
    function isValidUser() {
      let data = request.resource.data;
      return data.id is string
        && data.id.size() <= 128
        && data.name is string
        && data.name.size() <= 150
        && data.username is string
        && data.username.size() <= 100
        && data.passwordHash is string
        && (data.role == "admin" || data.role == "user");
    }
  }
}
